{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youtubesummarize",
  "main": "worker.py",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
